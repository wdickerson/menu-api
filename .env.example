# Copy to .env beside dev_server.py. Never commit the real .env or an API key.
# Dummy requests need no credentials. Enabling live calls incurs provider charges.
ENABLE_LIVE_TRANSCRIPTION=false
ENABLE_LIVE_SEARCH=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: use AWS Secrets Manager instead of a local key (requires AWS credentials).
# MENU_API_SECRET_ID=menu_api_secrets

# Sharing uses real DynamoDB, independently of the paid-operation flags above.
# Prefer a separate dev table with string partition key menu_id; no sort key.
# Use the stack's TranscribedMenuTableName output only if production writes are intended.
DYNAMO_TABLE=
AWS_DEFAULT_REGION=us-east-1
# Optional named AWS CLI/SSO profile; credentials are resolved by boto3, not stored here.
# AWS_PROFILE=menu-reader-dev